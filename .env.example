# Copy to .env next to docker-compose.yml. The container runs as this user, with this home path, so the mounted
# agent CLIs and their sign-ins work unchanged. `id -u`, `id -g`, `whoami`, `echo $HOME`.
MAP_UID=1000
MAP_GID=1000
MAP_USER=you
MAP_HOME=/home/you
# Node install whose bin/ has `node` (codex is a Node script); `dirname $(dirname $(readlink -f $(which node)))`.
MAP_NODE_DIR=/home/you/.local/node-v24.13.1-linux-x64
# The config folder: map.toml (start from deploy/map.docker.toml), templates/, agents/ and data/ (database, runs,
# corpus repos, git key, the default workspace). Mounted at the same path in the container.
# (Older .env files had MAP_DIR with data mounted at /data: set MAP_CONFIG_DIR to that folder and change data_dir
# and workspace.dir in its map.toml from /data/... to $MAP_CONFIG_DIR/data/... so the existing data is used.)
MAP_CONFIG_DIR=/home/you/MAP/config
# The project folder, mounted at the same path: projects can only be its sub-folders. Put the same path in
# map.toml's [projects] path.
MAP_PROJECTS_DIR=/home/you/MAP/workspace
# Host port, bound to 127.0.0.1 only.
MAP_PORT=4400
