# Copy to .env next to docker-compose.yml. The container runs as this user, with this home path, so the mounted
# agent CLIs and their sign-ins work unchanged. `id -u`, `id -g`, `whoami`, `echo $HOME`.
MAP_UID=1000
MAP_GID=1000
MAP_USER=you
MAP_HOME=/home/you
# Node install whose bin/ has `node` (codex is a Node script); `dirname $(dirname $(readlink -f $(which node)))`.
MAP_NODE_DIR=/home/you/.local/node-v24.13.1-linux-x64
# Host directory holding map.toml (start from deploy/map.docker.toml) and data/.
MAP_DIR=/home/you/map-deploy
# Host port, bound to 127.0.0.1 only.
MAP_PORT=4400
